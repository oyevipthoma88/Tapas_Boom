# ═══════════════════════════════════════════════════════════════════
# TAPAS BOOM v4.0 — Environment Variables (Proxy-Free Edition)
# ═══════════════════════════════════════════════════════════════════

# ── ZAROORI ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── OPTIONAL — Self-Ping URL (free hosting alive rakhne ke liye) ──
# UptimeRobot / BetterUptime se apni app URL add karo
# PING_URL=https://your-app.onrender.com
PING_URL=

# ── OPTIONAL — Webhook (Heroku/Render production ke liye) ─────────
# WEBHOOK_URL=https://your-app.onrender.com
WEBHOOK_URL=
